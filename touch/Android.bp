cc_binary {
    name: "vendor.lineage.touch-service.sdm660",
    init_rc: ["vendor.lineage.touch-service.sdm660.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.sdm660.xml"],
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "KeyDisabler.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libhidlbase",
        "libutils",
        "com.fingerprints.extension@1.0",
        "vendor.lineage.touch-V1-ndk",
    ],
}
