type debugfs_rmts, debugfs_type, fs_type;
type debugfs_wlan, debugfs_type, fs_type;
type fsg_firmware_file, file_type, contextmount_type, vendor_file_type;
type perfd_socket, file_type;
type persist_audio_file, file_type, vendor_persist_type;
type persist_camera_file, file_type;
type persist_mdm_file, file_type, vendor_persist_type;
type fingerprint_data_file, data_file_type, file_type;
type fingerprint_socket, data_file_type, file_type;
type sysfs_hwmon, sysfs_type, fs_type;
type sysfs_input, sysfs_type, fs_type;
type sysfs_sensor, sysfs_type, fs_type;
type sysfs_wifi, sysfs_type, fs_type;
type system_fps_data_file, file_type, data_file_type, core_data_file_type;

# charge_only_mode
type chargeonly_vendor_data_file, file_type, data_file_type;
type persist_chargeonly_file, file_type, data_file_type;

# Cutback
type cutback_data_file, file_type, data_file_type;
type cutback_socket, file_type;
type audio_cutback_data_file, file_type, data_file_type;

# Healthd
type sysfs_healthd, fs_type, sysfs_type, mlstrustedobject;

#rfs files
type rfs_tombstone_data_file, data_file_type, file_type;

# Motorola utags (/proc/config, /proc/hw) and bootinfo, same labels as
# hardware/motorola
type vendor_proc_hw, fs_type, proc_type;
type vendor_proc_moto_boot, fs_type, proc_type;

# Motorola utags partitions (read and written by the utags driver)
type utags_block_device, dev_type;

# init writes /proc/config/reload and /proc/hw/reload
allow { vendor_proc_hw vendor_proc_moto_boot } proc:filesystem associate;
