allow ueventd metadata_file:dir search;
allow ueventd self:capability sys_nice;

# ueventd walks debugfs to apply the ipc_logging label from the QTI debugfs
# file_contexts; that relabel is only useful while debugging
dontaudit ueventd { debugfs debugfs_wakeup_sources }:file getattr;
dontaudit ueventd debugfs:dir { r_dir_perms relabelfrom };
dontaudit ueventd qti_debugfs:dir relabelto;
